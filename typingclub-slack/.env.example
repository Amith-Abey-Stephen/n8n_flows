# Copy to .env and fill in. .env is gitignored.

# edclub / TypingClub
EDCLUB_BASE_URL=
# Access token: DevTools → Network → any /drf/ request → Authorization (raw value).
EDCLUB_AUTH_TOKEN=
# Refresh token: DevTools → Application → Cookies → finalapps.edclub.com → `rt`.
# This value goes into the workflow Config node's refreshTokenSeed.
EDCLUB_REFRESH_TOKEN=

# Slack — posting AS YOU via your browser session (no app).
#   SLACK_XOXC : Console → Object.values(JSON.parse(localStorage.localConfig_v2).teams).forEach(t=>console.log(t.token))
#   SLACK_XOXD : Application → Cookies → app.slack.com → value of cookie `d`
# In n8n these two go into the "Slack browser session" Custom Auth credential.
SLACK_CHANNEL=
SLACK_XOXC=
SLACK_XOXD=
