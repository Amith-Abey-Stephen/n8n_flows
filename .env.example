# edclub / TypingClub API
# Base URL only — the /drf/1.1.1 API prefix is added automatically.
EDCLUB_BASE_URL=
# Access token from an authenticated teacher browser session.
# DevTools → Network → any /drf/ request → Request Headers → Authorization.
# Paste the RAW value (no "Bearer"/"Token" prefix — the API rejects those).
EDCLUB_AUTH_TOKEN=

# Refresh token: DevTools → Application → Cookies → finalapps.edclub.com → `rt`.
# Optional but strongly recommended — access tokens expire quickly.
EDCLUB_REFRESH_TOKEN=

# Slack delivery — configure ONE of the two options:
# Option A (recommended): a Slack app bot token (xoxb-...) with the
# chat:write scope, plus the target channel ID (C0XXXXXXX). Invite the bot
# to the channel first (/invite @YourBot).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# Option B: an Incoming Webhook URL (https://hooks.slack.com/services/...).
# The webhook itself determines the channel.
SLACK_WEBHOOK_URL=

# Report schedule (defaults shown).
TIMEZONE=Asia/Kolkata
REPORT_HOUR=22
REPORT_MINUTE=0

# Parallel per-student API requests (1-10, default 3).
CONCURRENCY=3
