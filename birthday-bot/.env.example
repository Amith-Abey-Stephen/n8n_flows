# Copy to .env and fill in. .env is gitignored.

# Google Sheet (columns: Name, DOB as DD/MM/YYYY)
# Spreadsheet ID from the URL: docs.google.com/spreadsheets/d/<THIS>/edit
BIRTHDAY_SHEET_ID=
BIRTHDAY_SHEET_NAME=Sheet1

# Slack app bot
# Create at https://api.slack.com/apps → Create New App → From scratch
# OAuth & Permissions → Bot Token Scopes → chat:write → Install App
# Copy Bot User OAuth Token (xoxb-…)
# Invite bot to the channel: /invite @YourBot
SLACK_CHANNEL=
SLACK_BOT_TOKEN=
